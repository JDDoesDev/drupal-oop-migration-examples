<?php

/**
 * @file
 * Site-wide tweaks for the JD Does Dev site.
 */
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\jddoesdev_core\Hook\JddoesdevCoreHooks;
use Drupal\Component\Utility\Unicode;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function jddoesdev_core_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(JddoesdevCoreHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_form_alter().
 */
#[LegacyHook]
function jddoesdev_core_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  \Drupal::service(JddoesdevCoreHooks::class)->formAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_module_implements_alter().
 */
function jddoesdev_core_module_implements_alter(&$implementations, $hook) {
  // Our form_alter has to run after everything else, see #3012.
  if ($hook == 'form_alter' && isset($implementations['jddoesdev_core'])) {
    $group = $implementations['jddoesdev_core'];
    unset($implementations['jddoesdev_core']);
    $implementations['jddoesdev_core'] = $group;
  }
}

/**
 * Implements hook_preprocess_node().
 */
#[LegacyHook]
function jddoesdev_core_preprocess_node(array &$variables)
{
    \Drupal::service(JddoesdevCoreHooks::class)->preprocessNode($variables);
}

/**
 * Implements hook_node_presave().
 */
function jddoesdev_core_entity_presave(EntityInterface $entity) {
  if ($entity->getEntityTypeId() != 'node') {
    return;
  }
  $entity->setTitle(_jddoesdev_core_clean_title($entity->getTitle()));

  if ($entity->bundle() == 'article' && $entity->get('field_description')->isEmpty() && !$entity->get('field_content')->isEmpty()) {
    $text = strip_tags($entity->get('field_content')->value);
    $entity->set('field_description', Unicode::truncate(trim($text), 200, TRUE, TRUE));
  }

  \Drupal::logger('jddoesdev_core')->notice('%title saved by %user.', [
    '%title' => $entity->label(),
    '%user' => \Drupal::currentUser()->getAccountName(),
  ]);
}

/**
 * Tidies whitespace in a node title.
 */
function _jddoesdev_core_clean_title($title) {
  return preg_replace('/\s+/', ' ', trim($title));
}

/**
 * Implements hook_cron().
 */
#[LegacyHook]
function jddoesdev_core_cron()
{
    \Drupal::service(JddoesdevCoreHooks::class)->cron();
}

/**
 * Implements hook_page_attachments().
 */
#[LegacyHook]
function jddoesdev_core_page_attachments(array &$attachments) {
  \Drupal::service(JddoesdevCoreHooks::class)->pageAttachments($attachments);
}

function jddoesdev_core_mail_alter(&$message) {
  $footer = \Drupal::state()->get('jddoesdev_core.mail_footer');
  if (!$footer) {
    return;
  }
  foreach ($message['body'] as $line) {
    if (str_contains((string) $line, $footer)) {
      return;
    }
  }
  $message['body'][] = $footer;
}

// Guard against a fatal on sites that still have the old jddoesdev_access
// module enabled, which declared this same function. See #2954.
if (!function_exists('jddoesdev_core_node_access')) {

  /**
   * Implements hook_node_access().
   */
  #[LegacyHook]
  function jddoesdev_core_node_access($node, $op, $account)
  {
      return \Drupal::service(JddoesdevCoreHooks::class)->nodeAccess($node, $op, $account);
  }

}
