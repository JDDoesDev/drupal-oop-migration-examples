<?php

/**
 * @file
 * Site-wide tweaks for the JD Does Dev site.
 */

use Drupal\Core\Access\AccessResult;

// Guard against a fatal on sites that still have the old jddoesdev_access
// module enabled, which declared this same function. See #2954.
if (!function_exists('jddoesdev_core_node_access')) {

  /**
   * Implements hook_node_access().
   */
  function jddoesdev_core_node_access($node, $op, $account) {
    if ($op == 'delete' && $node->bundle() == 'project' && !$account->hasPermission('administer nodes')) {
      return AccessResult::forbidden()->cachePerPermissions();
    }
    return AccessResult::neutral();
  }

}
